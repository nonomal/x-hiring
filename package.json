{
  "name": "actnow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "dev": "vp run -r --parallel dev",
    "build": "vp run build:all",
    "dev:web": "vp run --filter web dev",
    "dev:start": "vp run --filter web start",
    "check-types": "vp run check-types:all",
    "test": "vp test run --passWithNoTests",
    "db:generate": "vp run --filter @actnow/db db:generate",
    "db:migrate": "vp run --filter web db:migrate",
    "db:migrate:local": "vp run --filter web db:migrate:local",
    "db:migrate:remote": "vp run --filter web db:migrate:remote",
    "db:migrate:production": "vp run --filter web db:migrate:production",
    "db:seed": "vp run --filter @actnow/db db:seed",
    "deploy": "vp run --filter web deploy:production",
    "deploy:development": "vp run --filter web deploy:development",
    "deploy:production": "vp run --filter web deploy:production",
    "cf-typegen": "vp run --filter web cf-typegen",
    "deploy:destroy": "vp run --filter web destroy"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.29.3"
}
