{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:prepare": "vp run db:migrate:local",
    "dev": "CLOUDFLARE_ENV=development vp run dev:prepare && CLOUDFLARE_ENV=development vp dev --port=3002",
    "dev:clean": "rm -rf node_modules/.vite && vp run dev",
    "preview": "vp preview",
    "build:development": "CLOUDFLARE_ENV=development vp build",
    "build:production": "CLOUDFLARE_ENV=production vp build",
    "deploy": "pnpm deploy:production",
    "deploy:development": "CLOUDFLARE_ENV=development vp build && CLOUDFLARE_ENV=development wrangler deploy --env development",
    "deploy:production": "CLOUDFLARE_ENV=production vp build && env -u CLOUDFLARE_ENV wrangler deploy --env=\"\"",
    "destroy": "wrangler delete",
    "cf-typegen": "wrangler types --env development",
    "db:migrate": "vp run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env development",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
